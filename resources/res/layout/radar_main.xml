<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/top_area"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="93px">
        <ImageView
            android:id="@+id/img_rearMirror"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28px"
            android:src="@drawable/rear_mirror_bg"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/img_radarAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="164px"
            android:src="@drawable/radar_alarm_bg"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/left_area"
        android:background="@color/black"
        android:layout_width="680px"
        android:layout_height="match_parent"
        android:layout_marginLeft="629px">
        <ImageView
            android:id="@+id/img_car"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="211px"
            android:layout_marginTop="134px"
            android:src="@mipmap/autopark_pic_car"/>
        <ImageView
            android:id="@+id/radar_front_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="242px"
            android:layout_marginTop="100px"/>
        <ImageView
            android:id="@+id/radar_front_middle_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="242px"
            android:layout_marginTop="100px"/>
        <ImageView
            android:id="@+id/radar_front_middle_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="242px"
            android:layout_marginTop="100px"/>
        <ImageView
            android:id="@+id/radar_front_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="242px"
            android:layout_marginTop="100px"/>
        <ImageView
            android:id="@+id/radar_rear_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="146px"
            android:layout_marginTop="483px"/>
        <ImageView
            android:id="@+id/radar_rear_middle_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="146px"
            android:layout_marginTop="483px"/>
        <ImageView
            android:id="@+id/radar_rear_middle_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="146px"
            android:layout_marginTop="483px"/>
        <ImageView
            android:id="@+id/radar_rear_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="146px"
            android:layout_marginTop="483px"/>
        <TextView
            android:textSize="24px"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/txt_angel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="80px"
            android:minWidth="200px"
            android:text="angel"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="118px"
        android:layout_marginTop="6px">
        <TextView
            android:textSize="28px"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/txt_err"
            android:background="@mipmap/autopark_bg_dialog"
            android:paddingLeft="30px"
            android:paddingRight="30px"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="450px"
            android:minHeight="100px"
            android:text=""
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <Button
        android:textSize="38px"
        android:textColor="@color/white"
        android:id="@+id/img_back"
        android:background="@drawable/radar_back_bg"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="230px"
        android:layout_marginTop="150px"
        android:text="@string/exit_text"/>
</RelativeLayout>
